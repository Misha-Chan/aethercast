# عنوان السيرفر الرئيسي لهوستاكا — كل طلبات /api/* بهذا المستودع تُمرَّر
# (proxy) إليه. القيمة الافتراضية بالكود لو ما ضبطت هذا المتغير هي
# https://hostaka.fun، فهو اختياري عملياً.
HOSTAKA_API_BASE=https://hostaka.fun

# منفذ التشغيل المحلي فقط (Vercel يتجاهل هذا)
PORT=3000

# أقصى عدد طلبات لكل IP بالدقيقة على مسارات /api/* (افتراضي 600)
RATE_LIMIT_MAX=600
